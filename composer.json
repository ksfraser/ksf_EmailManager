{
    "name": "ksfraser/ksf-emailmanager",
    "description": "Email Management - IMAP import, routing, mailing lists",
    "type": "php-package",
    "license": "GPL-3.0",
    "require": {
        "php": ">=8.1",
        "ksfraser/ksf-crm": "^1.0",
        "ksfraser/ksf-supporttickets": "^1.0",
        "ksfraser/event": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\EmailManager\\": "src/Ksfraser/EmailManager/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\EmailManager\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}